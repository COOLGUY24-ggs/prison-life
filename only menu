local function IsInVehicle()
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        return true
    end
    return false
end

local function HasWeaponInInventoryOrCharacter(weaponName)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    return (char and char:FindFirstChild(weaponName)) or (backpack and backpack:FindFirstChild(weaponName))
end

task.spawn(function()
    while true do
        if AutoWeaponsEnabled and not IsInVehicle() then
            local currentTeam = LocalPlayer.Team and LocalPlayer.Team.Name:lower() or ""
            if not currentTeam:find("criminal") then
                local hasRemington = HasWeaponInInventoryOrCharacter("Remington 870")
