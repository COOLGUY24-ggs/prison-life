    statsLabel.Position = UDim2.new(0, 10, 0, 32)
    statsLabel.BackgroundTransparency = 1
    statsLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
    statsLabel.TextSize = 12
    statsLabel.Font = Enum.Font.GothamMedium
    statsLabel.TextXAlignment = Enum.TextXAlignment.Left
    statsLabel.TextYAlignment = Enum.TextYAlignment.Top
    statsLabel.TextWrapped = true
    statsLabel.Text = "FPS: 60 | Ping: 0ms | Player: " .. LocalPlayer.Name
    statsLabel.Parent = banner

    task.spawn(function()
        local lastUpdate = tick()
        local frameCount = 0
        local currentFPS = 60
        
        RunService.RenderStepped:Connect(function(dt)
            frameCount = frameCount + 1
            if tick() - lastUpdate >= 1 then
                currentFPS = frameCount
                frameCount = 0
                lastUpdate = tick()
            end
            
            local pingVal = 0
            pcall(function()
                pingVal = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            end)
            
            statsLabel.Text = string.format("FPS: %d | Ping: %dms | Status: Online", currentFPS, pingVal)
        end)
    end)
end

