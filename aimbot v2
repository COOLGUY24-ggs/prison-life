VehicleTab:CreateButton({
    Name = "Get Car",
    Callback = function()
        local currentTime = tick()
        if currentTime - lastCarClickTime < 2.0 then return end -- 2 seconden cooldown check
        lastCarClickTime = currentTime

        task.spawn(function()
            local char = LocalPlayer.Character
            if not char then return end
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            if not rootPart then return end
            
            -- Sla de huidige locatie op
            local oldCFrame = rootPart.CFrame
            
            -- 1. Teleporteer eerst naar de opgegeven coördinaten
            rootPart.CFrame = CFrame.new(-193, 55, 1882)
            task.wait(0.2)
            
            -- 2. Vuur daarna de Car Spawner remote af
            local carArgs = {
                workspace:WaitForChild("Prison_ITEMS"):WaitForChild("buttons"):WaitForChild("Car Spawner"):WaitForChild("Car Spawner")
            }
            pcall(function()
                ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("InteractWithItem"):InvokeServer(unpack(carArgs))
            end)
            
            -- Wacht even tot de auto gespawned is
            task.wait(0.5)
            
            -- 3. Zoek de VehicleSeat en ga erin zitten
            local foundSeat = nil
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("VehicleSeat") and (obj.Position - rootPart.Position).Magnitude < 50 then
                    foundSeat = obj
                    break
                end
            end
            
            if foundSeat then
                rootPart.CFrame = foundSeat.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.1)
                foundSeat:Sit(char:FindFirstChildOfClass("Humanoid"))
                task.wait(0.2)
            end
            
            -- 4. Ga terug naar de oude locatie
            rootPart.CFrame = oldCFrame
        end)
    end,
})

VehicleTab:CreateToggle({
    Name = "Vehicle Fly (Look to Fly Up/Down)",
    CurrentValue = false,
    Flag = "JoystickFlyToggle",
    Callback = function(Value)
        JoystickFlyEnabled = Value
        
        if JoystickFlyEnabled then
            if flyConnection then
                flyConnection:Disconnect()
                flyConnection = nil
            end
            
            flyConnection = RunService.RenderStepped:Connect(function()
                if not JoystickFlyEnabled then return end
                
                local vehiclePart = GetCurrentVehiclePart()
                if vehiclePart then
                    local vehicleModel = vehiclePart.Parent
                    local primaryPart = nil
                    
                    if vehicleModel:IsA("Model") then
                        primaryPart = vehicleModel.PrimaryPart or vehicleModel:FindFirstChildWhichIsA("BasePart")
                    end
                    if not primaryPart then
                        primaryPart = vehiclePart
                    end
                    
                    if not primaryPart:FindFirstChild("FlyBodyVelocity") then
                        local bv = Instance.new("BodyVelocity")
                        bv.Name = "FlyBodyVelocity"
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Velocity = Vector3.new(0, 0, 0)
                        bv.Parent = primaryPart
                        
                        local bg = Instance.new("BodyGyro")
                        bg.Name = "FlyBodyGyro"
                        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                        bg.CFrame = primaryPart.CFrame
                        bg.Parent = primaryPart
                    end
                    
                    local bv = primaryPart:FindFirstChild("FlyBodyVelocity")
                    local bg = primaryPart:FindFirstChild("FlyBodyGyro")
                    
                    if bv and bg then
                        local camCFrame = Camera.CFrame
                        bg.CFrame = camCFrame
                        
                        local velocity = Vector3.new(0, 0, 0)
                        local char = LocalPlayer.Character
                        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                        
                        if humanoid then
                            local moveDirection = humanoid.MoveDirection
                            if moveDirection.Magnitude > 0 then
                                local localMove = (camCFrame.RightVector * (moveDirection:Dot(camCFrame.RightVector))) + (camCFrame.LookVector * (moveDirection:Dot(camCFrame.LookVector)))
                                if localMove.Magnitude > 0 then
                                    velocity = localMove.Unit * FlySpeed
                                end
                            end
                        end
                        
                        bv.Velocity = velocity
                    end
                else
                    for _, p in ipairs(Workspace:GetDescendants()) do
                        if p:IsA("BasePart") and (p.Name == "FlyBodyVelocity" or p.Name == "FlyBodyGyro") then
                            p:Destroy()
                        end
                    end
                end
            end)
        else
            if flyConnection then
                flyConnection:Disconnect()
                flyConnection = nil
            end
            for _, p in ipairs(Workspace:GetDescendants()) do
                if p:IsA("BasePart") and (p.Name == "FlyBodyVelocity" or p.Name == "FlyBodyGyro") then
                    p:Destroy()
                end
            end
        end
    end,
})

