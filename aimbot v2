local function IsAlive(player)
    if not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    return true
end

local function CanTargetByRankSimple(localPlayer, targetPlayer)
    if not TeamCheckEnabled then return true end
    local localTeam = localPlayer.Team and localPlayer.Team.Name:lower() or ""
    local targetTeam = targetPlayer.Team and targetPlayer.Team.Name:lower() or ""
    if localTeam ~= "" and localTeam == targetTeam then
        return false
    end
    return true
end

local function GetEquippedWeaponName(player)
    if not player.Character then return nil end
    for _, item in ipairs(player.Character:GetChildren()) do
        if item:IsA("Tool") then
            local nameLower = item.Name:lower()
            if nameLower ~= "breakfast" and nameLower ~= "lunch" and nameLower ~= "soda" then
                return item.Name
            end
        end
    end
    return nil
end

local function HasIgnoredItem(player)
    if not player.Character then return false end
    for _, item in ipairs(player.Character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name
            if name == "Soda" or name == "BreakFast" or name == "Breakfast" or name == "Lunch" then
                return true
            end
        end
    end
    return false
end

local function CanTargetByRankFull(localPlayer, targetPlayer)
    if not TeamCheckEnabled then return true end
    local localTeam = localPlayer.Team and localPlayer.Team.Name:lower() or ""
    local targetTeam = targetPlayer.Team and targetPlayer.Team.Name:lower() or ""
    if localTeam ~= "" and localTeam == targetTeam then
        return false
    end
    if localTeam:find("criminal") and targetTeam:find("inmate") then
        return false
    end
    if targetTeam:find("inmate") and HasIgnoredItem(targetPlayer) then
        return false
    end
    if localTeam:find("guard") and targetTeam:find("inmate") and GetEquippedWeaponName(targetPlayer) == nil then
        return false
    end
    return true
end

local function GetNearestPlayerForSimpleTaser()
    local nearestPlayer = nil
    local shortestDistance = 45
    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAlive(player) then
            if CanTargetByRankSimple(LocalPlayer, player) then
                local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
                if enemyRoot then
                    local distance = (localRoot.Position - enemyRoot.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestPlayer = player
                    end
                end
            end
        end
    end
    return nearestPlayer
end

local function GetNearestPlayerForShoot()
    local nearestPlayer = nil
    local shortestDistance = 45
    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAlive(player) then
            if CanTargetByRankFull(LocalPlayer, player) then
                local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
                if enemyRoot then
                    local distance = (localRoot.Position - enemyRoot.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestPlayer = player
                    end
                end
            end
        end
    end
    return nearestPlayer
end

local function SingleTaserShot()
    if IsInVehicle() then return end
    local targetPlayer = GetNearestPlayerForSimpleTaser()
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHead = targetPlayer.Character:FindFirstChild("Head")
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetHead or not targetRoot then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local localRoot = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not localRoot then return end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    
    local currentTool = char:FindFirstChildOfClass("Tool")
    local taserTool = char:FindFirstChild("Taser") or backpack:FindFirstChild("Taser")
    
    if taserTool then
        if currentTool ~= taserTool then
            humanoid:EquipTool(taserTool)
            task.wait(0.05)
        end
        
        local shootArgs = {
            {
                {
                    vector.create(localRoot.Position.X, localRoot.Position.Y, localRoot.Position.Z),
                    vector.create(targetHead.Position.X, targetHead.Position.Y, targetHead.Position.Z),
                    targetHead
                }
            }
        }
        
        local gunRemotes = ReplicatedStorage:FindFirstChild("GunRemotes")
        if gunRemotes then
            local shootEvent = gunRemotes:FindFirstChild("ShootEvent")
            if shootEvent then
                pcall(function()
                    shootEvent:FireServer(unpack(shootArgs))
                end)
            end
        end
    end
end

TaserButton.MouseButton1Click:Connect(function()
