    activeIndicator.Parent = tabBtn

    local indicatorCorner = Instance.new("UICorner")
    indicatorCorner.CornerRadius = UDim.new(1, 0)
    indicatorCorner.Parent = activeIndicator

    local tabScroll = Instance.new("ScrollingFrame")
    tabScroll.Name = name .. "Tab"
    tabScroll.Size = UDim2.new(1, -160, 1, -55)
    tabScroll.Position = UDim2.new(0, 155, 0, 50)
    tabScroll.BackgroundTransparency = 1
    tabScroll.BorderSizePixel = 0
    tabScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    tabScroll.ScrollBarThickness = 4
    tabScroll.Visible = false
    tabScroll.Parent = MainFrame

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 10)
    listLayout.Parent = tabScroll

    table.insert(tabButtonsList, {Button = tabBtn, Indicator = activeIndicator})

    tabBtn.MouseButton1Click:Connect(function()
        for _, frame in pairs(tabFrames) do
            frame.Visible = false
        end
        for _, item in ipairs(tabButtonsList) do
            item.Indicator.Visible = false
            item.Button.TextColor3 = Color3.fromRGB(160, 160, 180)
            TweenService:Create(item.Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 38)}):Play()
        end
        
        tabScroll.Visible = true
        activeIndicator.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(0, 255, 204)
        TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(32, 32, 48)}):Play()
        
        activeTab = tabScroll
    end)

    if not activeTab then
        tabScroll.Visible = true
        activeIndicator.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(0, 255, 204)
        tabBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 48)
        activeTab = tabScroll
    end

    table.insert(tabFrames, tabScroll)
    return tabScroll
end

