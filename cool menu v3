AddButton(VehicleTab, "Get Car", function()
    PlayNotificationSound()
    local currentTime = tick()
    if currentTime - lastCarClickTime < 2.0 then return end
    lastCarClickTime = currentTime

    task.spawn(function()
        local char = LocalPlayer.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        local buttonsFolder = Workspace:FindFirstChild("Prison_ITEMS") and Workspace.Prison_ITEMS:FindFirstChild("buttons")
        if not buttonsFolder then return end
        
        local nearestSpawner = nil
        local shortestDist = math.huge
        
        for _, item in ipairs(buttonsFolder:GetChildren()) do
            local carSpawnerPart = item:FindFirstChild("Car Spawner")
            if carSpawnerPart then
                local partPos = carSpawnerPart:IsA("BasePart") and carSpawnerPart.Position or (carSpawnerPart:IsA("Model") and carSpawnerPart:GetPivot().Position)
                if partPos then
                    local dist = (rootPart.Position - partPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestSpawner = carSpawnerPart
                    end
                end
            end
        end
        
        if not nearestSpawner then return end
        
        local oldCFrame = rootPart.CFrame
        local spawnerPos = nearestSpawner:IsA("BasePart") and nearestSpawner.Position or nearestSpawner:GetPivot().Position
        
        rootPart.CFrame = CFrame.new(spawnerPos + Vector3.new(0, 3, 0))
        task.wait(0.2)
        
        local carArgs = {
            nearestSpawner
        }
        pcall(function()
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("InteractWithItem"):InvokeServer(unpack(carArgs))
        end)
        
        task.wait(0.8)
        
        local foundSeat = nil
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("VehicleSeat") and (obj.Position - rootPart.Position).Magnitude < 60 then
                foundSeat = obj
                break
            end
        end
        
        if foundSeat then
            rootPart.CFrame = foundSeat.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.2)
            foundSeat:Sit(char:FindFirstChildOfClass("Humanoid"))
            task.wait(0.2)
        end
        
        rootPart.CFrame = oldCFrame
    end)
end)

