    statsLabel.Parent = banner

    task.spawn(function()
        local lastUpdate = tick()
        local frameCount = 0
        local currentFPS = 60
        
        RunService.RenderStepped:Connect(function(dt)
            frameCount = frameCount + 1
            if tick() - lastUpdate >= 1 then
                currentFPS = frameCount
                frameCount = 0
                lastUpdate = tick()
            end
            
            local pingVal = 0
            pcall(function()
                pingVal = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            end)
            
            statsLabel.Text = string.format("FPS: %d | Ping: %dms | Status: Online", currentFPS, pingVal)
        end)
    end)
end

