        humanoid:MoveTo(currentEnemyRoot.Position)
        
        local dist = (localRoot.Position - currentEnemyRoot.Position).Magnitude
        if dist <= 5 then
            break
        end
        task.wait(0.05)
    end

    humanoid:MoveTo(localRoot.Position)

    local handcuffsTool = char:FindFirstChild("Handcuffs") or backpack:FindFirstChild("Handcuffs") or char:FindFirstChild("Handcuff") or backpack:FindFirstChild("Handcuff")
