            if not JoystickFlyEnabled then return end
            
            local function GetCurrentVehiclePartLocal()
                local char = LocalPlayer.Character
                if not char then return nil end
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.SeatPart then
                    return humanoid.SeatPart
                end
                local rootPart = char:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    for _, child in ipairs(rootPart:GetChildren()) do
                        if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
                            local part0 = child.Part0
                            local part1 = child.Part1
                            local otherPart = (part0 == rootPart) and part1 or part0
                            if otherPart and otherPart.Parent and (otherPart.Parent:FindFirstChildOfClass("VehicleSeat") or otherPart.Parent:FindFirstChildOfClass("Seat") or otherPart:IsA("VehicleSeat") or otherPart:IsA("Seat")) then
                                return otherPart
                            end
                        end
                    end
                end
                return nil
            end

            local vehiclePart = GetCurrentVehiclePartLocal()
            if vehiclePart then
                local vehicleModel = vehiclePart.Parent
                local primaryPart = nil
                
                if vehicleModel:IsA("Model") then
                    primaryPart = vehicleModel.PrimaryPart or vehicleModel:FindFirstChildWhichIsA("BasePart")
                end
                if not primaryPart then
                    primaryPart = vehiclePart
                end
                
                if not primaryPart:FindFirstChild("FlyBodyVelocity") then
                    local bv = Instance.new("BodyVelocity")
                    bv.Name = "FlyBodyVelocity"
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = Vector3.new(0, 0, 0)
                    bv.Parent = primaryPart
                    
                    local bg = Instance.new("BodyGyro")
                    bg.Name = "FlyBodyGyro"
                    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    bg.CFrame = primaryPart.CFrame
                    bg.Parent = primaryPart
                end
                
                local bv = primaryPart:FindFirstChild("FlyBodyVelocity")
                local bg = primaryPart:FindFirstChild("FlyBodyGyro")
                
                if bv and bg then
                    local camCFrame = Camera.CFrame
                    bg.CFrame = camCFrame
                    
                    local velocity = Vector3.new(0, 0, 0)
                    local char = LocalPlayer.Character
                    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                    
                    if humanoid then
                        local moveDirection = humanoid.MoveDirection
                        if moveDirection.Magnitude > 0 then
                            local localMove = (camCFrame.RightVector * (moveDirection:Dot(camCFrame.RightVector))) + (camCFrame.LookVector * (moveDirection:Dot(camCFrame.LookVector)))
                            if localMove.Magnitude > 0 then
                                velocity = localMove.Unit * FlySpeed
                            end
                        end
                    end
                    
                    bv.Velocity = velocity
                end
            else
                for _, p in ipairs(Workspace:GetDescendants()) do
                    if p:IsA("BasePart") and (p.Name == "FlyBodyVelocity" or p.Name == "FlyBodyGyro") then
                        p:Destroy()
                    end
                end
            end
        end)
    else
        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end
        for _, p in ipairs(Workspace:GetDescendants()) do
            if p:IsA("BasePart") and (p.Name == "FlyBodyVelocity" or p.Name == "FlyBodyGyro") then
                p:Destroy()
            end
        end
    end
end)

