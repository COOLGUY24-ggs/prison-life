local function BuffedTaserAndArrestAction()
    local currentTime = tick()
    if isBuffedTaserRunning or IsInVehicle() or (currentTime - lastBuffedTaserTime < BuffedTaserCooldown) then return end
    
    isBuffedTaserRunning = true
    lastBuffedTaserTime = currentTime

    local targetPlayer = GetValidTargetForBuffedTaser()
    if not targetPlayer or not targetPlayer.Character then 
        isBuffedTaserRunning = false
        return 
    end

    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then 
        isBuffedTaserRunning = false
        return 
    end
    
    local char = LocalPlayer.Character
    if not char then 
        isBuffedTaserRunning = false
        return 
    end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local localRoot = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not localRoot then 
        isBuffedTaserRunning = false
        return 
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then 
        isBuffedTaserRunning = false
        return 
    end

    local oldCFrame = localRoot.CFrame
    humanoid.WalkSpeed = 24

    local targetVelocity = targetRoot.Velocity
    local predictedPosition = targetRoot.Position + (targetVelocity * 0.25)

    localRoot.CFrame = CFrame.new(predictedPosition - (targetRoot.CFrame.LookVector * 4) + Vector3.new(0, 3, 0), predictedPosition)
    task.wait(0.15)

    local startTime = tick()
    while tick() - startTime < 1.5 do
        if not IsAlive(targetPlayer) or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            break
        end
        
        local currentEnemyRoot = targetPlayer.Character.HumanoidRootPart
        humanoid:MoveTo(currentEnemyRoot.Position)
        
        local dist = (localRoot.Position - currentEnemyRoot.Position).Magnitude
        if dist <= 5 then
            break
        end
        task.wait(0.05)
