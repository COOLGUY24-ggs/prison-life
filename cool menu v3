local function GetCurrentVehiclePartGlobal()
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        return humanoid.SeatPart
    end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if rootPart then
        for _, child in ipairs(rootPart:GetChildren()) do
            if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
                local part0 = child.Part0
                local part1 = child.Part1
                local otherPart = (part0 == rootPart) and part1 or part0
                if otherPart and otherPart.Parent and (otherPart.Parent:FindFirstChildOfClass("VehicleSeat") or otherPart.Parent:FindFirstChildOfClass("Seat") or otherPart:IsA("VehicleSeat") or otherPart:IsA("Seat")) then
                    return otherPart
                end
            end
        end
    end
    return nil
end

local function IsInVehicle()
    return GetCurrentVehiclePartGlobal() ~= nil
end

AddButton(VehicleTab, "Go To Criminal", function()
    PlayNotificationSound()
    if not IsInVehicle() then
        ShowCoolNotification("Get in a car")
        return
    end

    local criminals = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team then
            local teamName = player.Team.Name:lower()
            if teamName:find("criminal") then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    table.insert(criminals, char.HumanoidRootPart)
                end
            end
        end
    end

    if #criminals > 0 then
        local randomCriminalPart = criminals[math.random(1, #criminals)]
        local vehiclePart = GetCurrentVehiclePartGlobal()
        local vehicleModel = vehiclePart.Parent
        local primaryPart = vehicleModel:IsA("Model") and (vehicleModel.PrimaryPart or vehicleModel:FindFirstChildWhichIsA("BasePart")) or vehiclePart

        if primaryPart then
            primaryPart.CFrame = randomCriminalPart.CFrame + Vector3.new(0, 5, 0)
        end
    else
        ShowCoolNotification("No criminals found!")
    end
end)

AddButton(VehicleTab, "Get Car", function()
    PlayNotificationSound()
    local currentTime = tick()
    if currentTime - lastCarClickTime < 2.0 then return end
    lastCarClickTime = currentTime

    task.spawn(function()
        local char = LocalPlayer.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        local buttonsFolder = Workspace:FindFirstChild("Prison_ITEMS") and Workspace.Prison_ITEMS:FindFirstChild("buttons")
        if not buttonsFolder then return end
        
        local nearestSpawner = nil
        local shortestDist = math.huge
        
        for _, item in ipairs(buttonsFolder:GetChildren()) do
            local carSpawnerPart = item:FindFirstChild("Car Spawner")
            if carSpawnerPart then
                local partPos = carSpawnerPart:IsA("BasePart") and carSpawnerPart.Position or (carSpawnerPart:IsA("Model") and carSpawnerPart:GetPivot().Position)
                if partPos then
                    local dist = (rootPart.Position - partPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestSpawner = carSpawnerPart
                    end
                end
            end
        end
        
        if not nearestSpawner then return end
        
        local oldCFrame = rootPart.CFrame
        local spawnerPos = nearestSpawner:IsA("BasePart") and nearestSpawner.Position or nearestSpawner:GetPivot().Position
        
        rootPart.CFrame = CFrame.new(spawnerPos + Vector3.new(0, 3, 0))
        task.wait(0.2)
        
        local carArgs = {
            nearestSpawner
        }
        pcall(function()
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("InteractWithItem"):InvokeServer(unpack(carArgs))
        end)
        
        task.wait(0.8)
        
        local foundSeat = nil
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("VehicleSeat") and (obj.Position - rootPart.Position).Magnitude < 60 then
                foundSeat = obj
                break
            end
        end
        
        if foundSeat then
            rootPart.CFrame = foundSeat.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.2)
            foundSeat:Sit(char:FindFirstChildOfClass("Humanoid"))
            task.wait(0.2)
        end
        
        rootPart.CFrame = oldCFrame
    end)
end)

