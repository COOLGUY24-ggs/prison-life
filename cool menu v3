local function ExecuteTaserAndSpamArrest(targetPlayer)
    if isTaserOrArresting or IsInVehicle() then return end
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHead = targetPlayer.Character:FindFirstChild("Head")
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetHead or not targetRoot then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local localRoot = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not localRoot then return end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    
    isTaserOrArresting = true
    
    local currentTool = char:FindFirstChildOfClass("Tool")
    local taserTool = char:FindFirstChild("Taser") or backpack:FindFirstChild("Taser")
    
    if taserTool then
        if currentTool ~= taserTool then
            humanoid:EquipTool(taserTool)
            task.wait(0.1)
        end
        
        local shootArgs = {
            {
                {
                    vector.create(localRoot.Position.X, localRoot.Position.Y, localRoot.Position.Z),
                    vector.create(targetHead.Position.X, targetHead.Position.Y, targetHead.Position.Z),
                    targetHead
                }
            }
        }
        
        local gunRemotes = ReplicatedStorage:FindFirstChild("GunRemotes")
        if gunRemotes then
            local shootEvent = gunRemotes:FindFirstChild("ShootEvent")
            if shootEvent then
                for i = 1, 4 do
                    if IsInVehicle() then break end
                    pcall(function()
                        shootEvent:FireServer(unpack(shootArgs))
                    end)
                    task.wait(0.08)
                end
            end
            
            local funcReload = gunRemotes:FindFirstChild("FuncReload")
            if funcReload then
                pcall(function()
                    funcReload:InvokeServer()
                end)
            end
        end
    end
    
    local handcuffsTool = char:FindFirstChild("Handcuffs") or backpack:FindFirstChild("Handcuffs") or char:FindFirstChild("Handcuff") or backpack:FindFirstChild("Handcuff")
    if handcuffsTool and not IsInVehicle() then
        humanoid:EquipTool(handcuffsTool)
        task.wait(0.1)
        
        local arrestArgs = {
            targetPlayer,
            1
        }
        
        local arrestEvent = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("ArrestPlayer")
        
        if arrestEvent then
            for i = 1, 6 do
                if IsInVehicle() or not IsAlive(targetPlayer) or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then break end
                local currentDistance = (localRoot.Position - targetPlayer.Character.HumanoidRootPart.Position).Magnitude
                if currentDistance > 13 then
                    break
                end
                
                pcall(function()
                    arrestEvent:InvokeServer(unpack(arrestArgs))
                end)
                task.wait(0.1)
            end
        end
    end
    
    isTaserOrArresting = false
end

