end

task.spawn(function()
    while true do
        if AutoWeaponsEnabled and not IsInVehicle() then
            local currentTeam = LocalPlayer.Team and LocalPlayer.Team.Name:lower() or ""
            local isCriminal = currentTeam:find("criminal") ~= nil
            
            if not isCriminal then
                local hasRemington = HasWeaponInInventoryOrCharacter("Remington 870")
                local hasMP5 = HasWeaponInInventoryOrCharacter("MP5")
                
                if not (hasRemington and hasMP5) then
                    local char = LocalPlayer.Character
                    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                    
                    if rootPart then
                        local buttonsFolder = Workspace:FindFirstChild("Prison_ITEMS") and Workspace.Prison_ITEMS:FindFirstChild("buttons")
                        local nearestSpawner = nil
                        local shortestDist = math.huge
                        
                        if buttonsFolder then
                            for _, item in ipairs(buttonsFolder:GetChildren()) do
                                local spawnerPart = item:FindFirstChild("Car Spawner") or item:FindFirstChildWhichIsA("BasePart")
                                if spawnerPart then
                                    local partPos = spawnerPart:IsA("BasePart") and spawnerPart.Position or spawnerPart:GetPivot().Position
                                    local dist = (rootPart.Position - partPos).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        nearestSpawner = spawnerPart
                                    end
                                end
                            end
                        end
                        
                        local oldCFrame = rootPart.CFrame
                        if nearestSpawner then
                            local spawnerPos = nearestSpawner:IsA("BasePart") and nearestSpawner.Position or nearestSpawner:GetPivot().Position
                            rootPart.CFrame = CFrame.new(spawnerPos)
                        else
                            rootPart.CFrame = CFrame.new(817, 98, 2222)
                        end
                        
                        task.wait(0.4)
                        
                        if not hasMP5 then
                            pcall(function()
                                local mp5Args = {
                                    Workspace:WaitForChild("Prison_ITEMS"):WaitForChild("giver"):WaitForChild("MP5"):WaitForChild("Meshes/MP5 (2)")
                                }
                                ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("InteractWithItem"):InvokeServer(unpack(mp5Args))
                            end)
                            task.wait(0.3)
                        end
                        
                        if not hasRemington then
                            pcall(function()
                                local r870Args = {
                                    Workspace:WaitForChild("Prison_ITEMS"):WaitForChild("giver"):WaitForChild("Remington 870"):WaitForChild("Meshes/r870_2")
                                }
                                ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("InteractWithItem"):InvokeServer(unpack(r870Args))
                            end)
                            task.wait(0.3)
                        end
                        
                        rootPart.CFrame = oldCFrame
                    end
                end
            end
        end
        task.wait(2)
    end
end)

RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    fovCircle.Position = mousePos

    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if LightningPinnedToMenu then
        ToggleButton.Position = MainFrame.Position + UDim2.new(0, -55, 0, 0)
    end

    if IsInVehicle() then
        return
    end

    if AutoMeleeEnabled then
        local currentTime = tick()
        if currentTime - lastMeleeTime >= 0.2 then
            lastMeleeTime = currentTime
            local nearestTarget = GetNearestPlayerForMelee()
            if nearestTarget then
                pcall(function()
                    local meleeArgs = {
                        nearestTarget,
                        1,
                        1
                    }
                    ReplicatedStorage:WaitForChild("meleeEvent"):FireServer(unpack(meleeArgs))
                end)
            end
        end
    end

    if AutoShootEnabled and localRoot and not isTaserOrArresting then
        local target = GetNearestPlayerForShoot()
        if target then
            task.spawn(function()
                ExecuteTaserAndSpamArrest(target)
            end)
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if ESPEnabled and IsAlive(player) and char then
                local head = char:FindFirstChild("Head")
                local highlight = char:FindFirstChild("TeamHighlight")
                local weaponName = GetEquippedWeaponName(player)
                local teamName = player.Team and player.Team.Name or ""
                local isCriminal = teamName:lower():find("criminal") ~= nil

                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "TeamHighlight"
                    highlight.Adornee = char
                    highlight.Parent = char
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
                
                if isCriminal then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                elseif teamName:lower():find("guard") then
                    highlight.FillColor = Color3.fromRGB(0, 0, 255)
                elseif teamName:lower():find("inmate") then
                    highlight.FillColor = Color3.fromRGB(255, 165, 0)
                else
                    highlight.FillColor = Color3.fromRGB(255, 255, 255)
                end

                if head then
                    local billboard = head:FindFirstChild("WeaponTag")
                    if weaponName and not isCriminal then
                        if not billboard then
                            billboard = Instance.new("BillboardGui")
                            billboard.Name = "WeaponTag"
                            billboard.Size = UDim2.new(0, 200, 0, 50)
                            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                            billboard.AlwaysOnTop = true
                            billboard.Parent = head

                            local textLabel = Instance.new("TextLabel")
                            textLabel.Name = "Text"
                            textLabel.Size = UDim2.new(1, 0, 1, 0)
                            textLabel.BackgroundTransparency = 1
                            textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
                            textLabel.TextStrokeTransparency = 0
                            textLabel.TextSize = 14
                            textLabel.Font = Enum.Font.SourceSansBold
                            textLabel.Parent = billboard
                        end
                        billboard.Text.Text = "Weapon: " .. weaponName
                        billboard.Enabled = true
                    else
                        if billboard then
                            billboard.Enabled = false
                        end
                    end
                end
            else
                if char then
                    if char:FindFirstChild("TeamHighlight") then
                        char.TeamHighlight:Destroy()
                    end
                    local head = char:FindFirstChild("Head")
                    if head and head:FindFirstChild("WeaponTag") then
                        head.WeaponTag:Destroy()
                    end
                end
            end
        end
    end

    if AimlockEnabled then
        local closestPlayer = nil
        local shortestDistance = FOVRadius

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and IsAlive(player) and player.Character:FindFirstChild("Head") then
                if CanTargetByRankFull(LocalPlayer, player) then
                    local head = player.Character.Head
                    
                    if localRoot and player.Character:FindFirstChild("HumanoidRootPart") then
                        local targetRootPart = player.Character.HumanoidRootPart
                        local distanceInStuds = (localRoot.Position - targetRootPart.Position).Magnitude
                        if distanceInStuds <= MaxAimlockDistance then
                            local origin = Camera.CFrame.Position
                            local direction = (head.Position - origin)
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
                            local result = Workspace:Raycast(origin, direction, raycastParams)
                            local isVisible = false
                            if result and result.Instance:IsDescendantOf(head.Parent) then
                                isVisible = true
                            elseif not result then
                                isVisible = true
                            end

                            if isVisible then
                                local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                                if onScreen then
                                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                                    if distance < shortestDistance then
                                        shortestDistance = distance
                                        closestPlayer = player
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Character.Head.Position)
        end
    end
end)
