        else
            currentTargetPlayer = nil
        end
    else
        currentTargetPlayer = nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if ESPEnabled and IsAlive(player) and char then
                local head = char:FindFirstChild("Head")
                local highlight = char:FindFirstChild("TeamHighlight")
                local weaponName = GetEquippedWeaponName(player)
                local teamName = player.Team and player.Team.Name or ""
                local isCriminal = teamName:lower():find("criminal") ~= nil

                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "TeamHighlight"
                    highlight.Adornee = char
                    highlight.Parent = char
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
                
                if isCriminal then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                elseif teamName:lower():find("guard") then
                    highlight.FillColor = Color3.fromRGB(0, 0, 255)
                elseif teamName:lower():find("inmate") then
                    highlight.FillColor = Color3.fromRGB(255, 165, 0)
                else
                    highlight.FillColor = Color3.fromRGB(255, 255, 255)
                end

                if head then
                    local billboard = head:FindFirstChild("WeaponTag")
                    if weaponName and not isCriminal then
                        if not billboard then
                            billboard = Instance.new("BillboardGui")
                            billboard.Name = "WeaponTag"
                            billboard.Size = UDim2.new(0, 200, 0, 50)
                            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                            billboard.AlwaysOnTop = true
                            billboard.Parent = head

                            local textLabel = Instance.new("TextLabel")
                            textLabel.Name = "Text"
                            textLabel.Size = UDim2.new(1, 0, 1, 0)
                            textLabel.BackgroundTransparency = 1
                            textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
                            textLabel.TextStrokeTransparency = 0
                            textLabel.TextSize = 14
                            textLabel.Font = Enum.Font.SourceSansBold
                            textLabel.Parent = billboard
                        end
                        billboard.Text.Text = "Weapon: " .. weaponName
                        billboard.Enabled = true
                    else
                        if billboard then
                            billboard.Enabled = false
                        end
                    end
                end
            else
                if char then
                    if char:FindFirstChild("TeamHighlight") then
                        char.TeamHighlight:Destroy()
                    end
                    local head = char:FindFirstChild("Head")
                    if head and head:FindFirstChild("WeaponTag") then
                        head.WeaponTag:Destroy()
                    end
                end
            end
        end
    end
end)
